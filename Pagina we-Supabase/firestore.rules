rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para el Sistema de Asistencia y Control QR - Proyecto GEF Bermejo
    match /asistencia_gef_bermejo/{documentoId} {
      // Permite lectura y escritura para el registro y consulta de asistencia
      allow read, write: if true;
    }
  }
}

